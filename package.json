{
  "name": "atlaspen",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "verificar": "tsc -p scripts/tsconfig.verificar.json && node .verificar-build/scripts/verificar_atributos.js && node .verificar-build/scripts/verificar_injecao.js && node .verificar-build/scripts/verificar_pena.js && node .verificar-build/scripts/verificar_simulacao.js && node .verificar-build/scripts/verificar_remissao.js && node .verificar-build/scripts/verificar_casos.js",
    "equivalencia": "tsc -p scripts/tsconfig.verificar.json && node .verificar-build/scripts/equivalencia_atributos.js",
    "atributos": "tsc -p scripts/tsconfig.verificar.json && node .verificar-build/scripts/derivar_atributos.js",
    "changelog:json": "node scripts/gerar-changelog-json.mjs",
    "mortos": "knip"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "astro": "^7.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.38.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
