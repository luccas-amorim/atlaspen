{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": false,
    "outDir": "../.verificar-build",
    "rootDir": ".."
  },
  "include": [
    "verificar_atributos.ts",
    "verificar_injecao.ts",
    "verificar_pena.ts",
    "verificar_simulacao.ts",
    "verificar_remissao.ts",
    "verificar_casos.ts",
    "equivalencia_atributos.ts",
    "derivar_atributos.ts",
    "../src/lib/**/*.ts"
  ]
}
